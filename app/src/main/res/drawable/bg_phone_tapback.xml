<?xml version="1.0" encoding="utf-8"?>
<!-- A tapback on a bubble's corner in iPhone-style chats: others' in the incoming grey, ringed in the screen's colour. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="10dp"
    android:insetBottom="10dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/phone_incoming" />
        <stroke
            android:width="2dp"
            android:color="@color/phone_screen" />
        <corners android:radius="14dp" />
    </shape>
</inset>
