<?xml version="1.0" encoding="utf-8"?>
<!-- Conversations in the top row of Android's share sheet (chat.ShareShortcuts) open the share screen. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.lightdecoder.ui.share.ShareActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="audio/*" />
        <category android:name="com.lightdecoder.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
