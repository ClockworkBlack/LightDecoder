<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing of LightDecoder leaves the phone through Android's backup or
    device-to-device transfer: the sticker inbox, the message archive, the
    encrypted Google Messages session and the settings are all excluded.
    (The session key lives in the Keystore and would not survive a transfer
    anyway.) The device_* domains are device-protected storage, unused today
    but excluded so that nothing added there later leaks either. Android 12
    and later read this file; older versions read
    android:fullBackupContent="false" and android:allowBackup="false".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
