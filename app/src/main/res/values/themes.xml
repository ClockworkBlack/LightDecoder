<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.LightDecoder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <!--
        The top bar's overflow menu: its checkboxes (Blue Bubbles) are drawn in the text colour,
        white on the dark theme, instead of the accent colour.
    -->
    <!-- The video player: black, edge to edge, no title bar. -->
    <style name="Theme.LightDecoder.Video" parent="Theme.LightDecoder">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!--
        The thread view of iPhone-style chats: over the whole chat, which shows through it (blurred
        where Android can), edge to edge; it draws its own veil.
    -->
    <style name="Theme.LightDecoder.ThreadPanel" parent="Theme.LightDecoder">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <!--
        The FaceTime call screen: dark whatever the phone's theme (a call screen, and the other
        side's picture, read best on black), edge to edge.
    -->
    <style name="Theme.LightDecoder.Call" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="android:windowBackground">@color/call_screen</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The word under a round button of the call screen. -->
    <style name="Widget.LightDecoder.CallLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/call_on_screen</item>
        <item name="android:textSize">12sp</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">4</item>
    </style>

    <style name="ThemeOverlay.LightDecoder.MenuPopup" parent="ThemeOverlay.Material3">
        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="colorControlActivated">?attr/colorOnSurface</item>
        <!-- Material 3's checkbox takes its colour from its own tint, not colorControlActivated. -->
        <item name="checkboxStyle">@style/Widget.LightDecoder.MenuCheckBox</item>
    </style>

    <style name="Widget.LightDecoder.MenuCheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/menu_checkbox_tint</item>
        <item name="android:buttonTint">@color/menu_checkbox_tint</item>
        <!-- The tick itself: the menu's own dark colour, or it is white on the white box and the box looks empty. -->
        <item name="buttonIconTint">@color/menu_checkbox_icon_tint</item>
    </style>
</resources>
