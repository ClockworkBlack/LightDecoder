<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
        One slim row: the app switcher ("Discord ▾") and the menu, nothing else, so Discord's
        page has the screen. Back is the system's.
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:minHeight="44dp"
        app:contentInsetStart="12dp">

        <include layout="@layout/view_app_switcher" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- The apps, as tabs that are not shown (see ServiceTabStrip). -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/services"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:tabMode="scrollable" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:visibility="gone" />

    <!-- Shown while Discord is on its own sign-in or sign-up page. -->
    <LinearLayout
        android:id="@+id/signInBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorTertiaryContainer"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/discord_sign_in_banner"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnTertiaryContainer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signInQr"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/discord_qr_sign_in" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signInOpenApp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/discord_open_app" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pageFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurface"
        android:clipChildren="true">

        <!-- The page view (DiscordPage) is put here, beneath the panels below; it outlives this screen. -->

        <LinearLayout
            android:id="@+id/errorPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/discord_error_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/discord_error_body"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/errorOpenApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/discord_open_app" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/errorRetry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/discord_try_again" />
        </LinearLayout>
        <!-- Sign in with a QR code: the code Discord's page shows, and what to do with it. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/qrPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/qrStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/discord_qr_looking"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <ImageView
                    android:id="@+id/qrImage"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/discord_qr_image"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qrApprove"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/discord_qr_approve" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qrClose"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/discord_qr_close" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</LinearLayout>
