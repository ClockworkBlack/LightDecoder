<?xml version="1.0" encoding="utf-8"?>
<!-- Photos sent together in one message: a collage (2-3) or a stack (4 or more), as on an iPhone. A tap shows them all. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stackFrame"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true">

    <com.lightdecoder.ui.chat.MediaStackView
        android:id="@+id/stackView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/stackCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_media_status"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSecondaryContainer"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</FrameLayout>
