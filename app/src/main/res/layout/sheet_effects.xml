<?xml version="1.0" encoding="utf-8"?>
<!-- "Send with effect" (the send button held down in an iMessage chat), as on an iPhone:
     Bubble or Screen, the message in a blue bubble, the effects, and the round send arrow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/effectClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@android:string/cancel"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/effectTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingVertical="12dp"
            android:text="@string/imessage_effect_pick_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/effectTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:checkedButton="@+id/effectTabBubble"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/effectTabBubble"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/imessage_effect_tab_bubble" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/effectTabScreen"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/imessage_effect_tab_screen" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/effectPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="@drawable/bg_bubble"
                android:backgroundTint="@color/imessage_blue"
                android:ellipsize="end"
                android:maxLines="4"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/on_imessage_blue" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/effectSend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:alpha="0.4"
            android:background="@drawable/bg_effect_send"
            android:contentDescription="@string/chat_send"
            android:enabled="false"
            android:src="@drawable/ic_arrow_upward"
            app:tint="@color/on_imessage_blue" />
    </LinearLayout>

    <TextView
        android:id="@+id/effectHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/imessage_effect_pick_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioGroup
                android:id="@+id/effectBubbleList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <RadioGroup
                android:id="@+id/effectScreenList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
