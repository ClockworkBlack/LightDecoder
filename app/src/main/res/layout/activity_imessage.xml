<?xml version="1.0" encoding="utf-8"?>
<!-- iMessage setup (ui/imessage/DirectSetupActivity), from the Messages tab's menu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/imessage_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="24dp">

            <!-- Status: green only when Apple reports the registration as done. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_unread_dot" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statusTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/statusBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/statusProgress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 1: OpenBubbles' files, imported from the user's own copy. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/libraryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/imessage_library_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <TextView
                        android:id="@+id/libraryBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/importLibrary"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/imessage_library_import" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 2: register this phone's number, with the iPhone relay. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/registerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/imessage_register_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/imessage_register_body"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/imessage_backup_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/imessage_relay_code">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/relayCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textVisiblePassword|textNoSuggestions"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/imessage_relay_host">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/relayHost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pasteReply"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/imessage_paste_reply"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/register"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/imessage_register" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- The optional Apple Account (AppleAccountActivity): only once this phone's number is registered. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/appleAccountCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/appleAccountTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/apple_account_row"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <!-- Said once, after something happened to the account. -->
                    <TextView
                        android:id="@+id/appleAccountNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/appleAccountBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/apple_account_row_help"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/appleAccountIcloud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/appleKeychain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />

                    <!-- Without an account: only that these need it. -->
                    <TextView
                        android:id="@+id/appleFeaturesHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/apple_features_need_account"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:visibility="gone" />

                    <!-- What the account brings (B6): only signed in, with iCloud's features on. -->
                    <LinearLayout
                        android:id="@+id/appleFeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/appleRowNamePhoto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:filterTouchesWhenObscured="true"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:id="@+id/appleRowFocus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:filterTouchesWhenObscured="true"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:id="@+id/appleRowIcloud"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:filterTouchesWhenObscured="true"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/appleAccountAction"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:filterTouchesWhenObscured="true"
                        android:text="@string/apple_account_sign_in_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings of the library's own (this process's DirectPrefs). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/settingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchReadReceipts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/imessage_read_receipts" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/imessage_read_receipts_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <!-- iPhone-style chats (DirectPrefs.phoneStyleOn, read in the main process by the chat screen). -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPhoneStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/imessage_phone_style" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/imessage_phone_style_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <!-- iPhone-style chats: inline replies drawn in the chat itself (DirectPrefs.replyThreadsInChat, read in the main process). -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchReplyThreads"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/imessage_reply_threads_in_chat" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/imessage_reply_threads_in_chat_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <!-- Link previews of links the user sends (DirectPrefs.linkPreviews, read in the main process, which fetches the page). -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchLinkPreviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/imessage_link_previews" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/imessage_link_previews_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <!-- Addresses for the locations people send (DirectPrefs.locationAddresses): off, as nothing is sent anywhere then. -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchLocationAddresses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/location_show_addresses" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/location_show_addresses_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <!-- Screen effects for phrases ("Happy Birthday"), on as on an iPhone (DirectPrefs.phraseEffects, read by the chat screen). -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPhraseEffects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/imessage_phrase_effects" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/imessage_phrase_effects_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <!-- Deletes on the user's other Apple devices too (DirectPrefs.deleteOnAllDevices): off, deletes stay here. -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDeleteOnAllDevices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/imessage_delete_on_all_devices" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/imessage_delete_on_all_devices_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <!-- A mention notifies even with a chat's alerts hidden (DirectPrefs.notifyWhenMentioned, read in the main process). -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNotifyMentions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/imessage_notify_mentions" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/imessage_notify_mentions_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <!-- iMessage games (DirectPrefs.gamesOn, read in the main process): OpenPigeon plays them. -->
                    <!-- FaceTime calls (DirectPrefs.faceTimeOn, read by the call engine here and the chat screens in the main process). -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchFaceTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/facetime_setting" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/facetime_setting_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <!-- What stands in the way of a call ringing, with FaceTime on: notifications off, or no call screen over the lock screen. -->
                    <TextView
                        android:id="@+id/faceTimeStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/faceTimeFix"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/facetime_open_settings"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSilenceUnknown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/facetime_silence_unknown" />

                    <TextView
                        android:id="@+id/silenceUnknownHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/facetime_silence_unknown_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <!-- FaceTime through Android's Telecom (DirectPrefs.telecomOn, read by the call engine here): the kill switch. -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchTelecom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/facetime_telecom" />

                    <TextView
                        android:id="@+id/telecomHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/facetime_telecom_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <!-- The user's own block list (ui.chat.BlockedContactsActivity, main process). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/blockedContacts"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/blocked_contacts" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchGames"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/imessage_games" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/imessage_games_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <TextView
                        android:id="@+id/gamesStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/getGames"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/imessage_games_get" />

                    <!-- The service's status notice (ServiceNotice): its channel's system settings, to turn it off. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/hideStatus"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/imessage_hide_status" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/imessage_hide_status_help"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/whereNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="4dp"
                android:text="@string/imessage_where"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
