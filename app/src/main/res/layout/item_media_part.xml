<?xml version="1.0" encoding="utf-8"?>
<!-- One media part inside a bubble: a picture (or video still), or a file row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/mediaFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- Sized from the picture's real dimensions (see MediaImageView). -->
        <com.lightdecoder.ui.chat.MediaImageView
            android:id="@+id/mediaImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/mediaPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_play"
            android:visibility="gone" />

        <!-- A download's progress (a tap stops it), shown while one the user is waiting for comes. -->
        <com.lightdecoder.ui.chat.TransferRing
            android:id="@+id/transferRing"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:contentDescription="@string/transfer_stop_download"
            android:focusable="true"
            android:visibility="gone" />

        <!-- A Live Photo: it plays (held) in the photo viewer. -->
        <TextView
            android:id="@+id/mediaLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_media_status"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="@string/live_photo_badge"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- Shown while the picture can only be downloaded with the link connected. -->
        <TextView
            android:id="@+id/mediaStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="4dp"
            android:background="@drawable/bg_media_status"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/chat_media_connect_to_load"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/mediaFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_file" />

        <TextView
            android:id="@+id/mediaFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>

    <!-- A voice message (or other audio): played here, in the bubble. -->
    <LinearLayout
        android:id="@+id/mediaAudio"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/audioPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_voice_play"
            android:src="@drawable/ic_play" />

        <SeekBar
            android:id="@+id/audioProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/chat_voice_position"
            android:max="1000" />

        <TextView
            android:id="@+id/audioTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:minWidth="36dp"
            android:textAppearance="?attr/textAppearanceLabelMedium" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mediaFullSize"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_load_full_size"
        android:visibility="gone" />
</LinearLayout>
