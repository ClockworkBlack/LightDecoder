<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">

        <!-- iPhone-style chats: the person's picture with the name under it, in the middle; a tap opens the menu. -->
        <LinearLayout
            android:id="@+id/phoneHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:minWidth="48dp"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/phoneAvatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/phoneName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxWidth="200dp"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_phone_chevron"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- iPhone-style chats: a hairline under the bar. -->
    <View
        android:id="@+id/phoneHeaderLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- iMessage: the chat's sends with files going out, as iPhone's blue bar under the navigation bar. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/sendProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="1000"
        android:visibility="gone" />

    <include
        android:id="@+id/banner"
        layout="@layout/view_connection_banner" />

    <!--
        An iMessage chat with someone who is not in the user's contacts and whom the user never wrote
        to: "Report Junk", as an iPhone offers it.
    -->
    <LinearLayout
        android:id="@+id/junkBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/junkText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/imessage_junk_banner"
            android:textColor="@color/phone_meta"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/junkReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingHorizontal="12dp"
            android:text="@string/imessage_junk_report"
            android:textColor="@color/phone_red"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>


    <!--
        The Apple Account's banners (B6): a name and photo someone shared ("Update" / "Not Now"), and
        "Share your name and photo with …?". Only with a signed-in Apple Account.
    -->
    <LinearLayout
        android:id="@+id/profileBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/profileBannerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/phone_meta"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profileBannerYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profileBannerNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:text="@string/profile_not_now"
                android:textColor="@color/phone_meta"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The chat's background (iOS 26), behind the messages, with a light scrim for reading. -->
        <ImageView
            android:id="@+id/chatBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:id="@+id/chatBackgroundScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/chat_background_scrim"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp" />

        <!-- "Jump to first unread": the round arrow at the top right of a chat opened with unread messages above the screen (CatchUp). -->
        <ImageButton
            android:id="@+id/catchUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_day_header"
            android:contentDescription="@string/catch_up_jump"
            android:elevation="4dp"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_upward"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/chat_thread_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <!-- A background picked in the picker, shown behind the thread before it is sent: Cancel or Set. -->
        <LinearLayout
            android:id="@+id/backgroundPreviewBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_day_header"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="@string/imessage_background_preview_hint"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backgroundPreviewCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/imessage_background_preview_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backgroundPreviewSet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/imessage_background_preview_set" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/typingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingHorizontal="20dp"
        android:paddingVertical="2dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textStyle="italic"
        android:visibility="gone" />

    <!--
        iPhone-style chats: someone is typing, as a grey bubble with three moving dots; in a group with
        the picture (or initials) of who is typing beside it, as an iPhone shows it.
    -->
    <LinearLayout
        android:id="@+id/typingRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="2dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/typingAvatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.lightdecoder.ui.chat.TypingDotsView
            android:id="@+id/typingDots"
            android:layout_width="64dp"
            android:layout_height="38dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Replying to … -->
    <LinearLayout
        android:id="@+id/replyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_day_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_reply" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/replySender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/replyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/replyClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_reply_cancel"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- The picked attachment, sent with the next message. -->
    <LinearLayout
        android:id="@+id/attachmentBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_day_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/attachmentThumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/attachmentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <ImageButton
            android:id="@+id/attachmentRemove"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_attachment_remove"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Recording a voice message: in place of the composer until it is sent or thrown away. -->
    <LinearLayout
        android:id="@+id/recordingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/recordingCancel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_voice_cancel"
            android:src="@drawable/ic_delete" />

        <View
            android:id="@+id/recordingDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_recording_dot"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/recordingTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <ImageButton
            android:id="@+id/recordingSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_voice_send"
            android:src="@drawable/ic_send"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- iMessage groups: the members whose names start with what is typed after "@", to mention one (iOS 17). -->
    <HorizontalScrollView
        android:id="@+id/mentionSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/imessage_mention_suggestions"
        android:paddingHorizontal="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/mentionChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>


    <!-- "<name> has notifications silenced", with "Notify Anyway" (B6.3: Apple Account only). -->
    <LinearLayout
        android:id="@+id/focusBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/focusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:textColor="@color/phone_meta"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/focusNotify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="36dp"
            android:paddingHorizontal="12dp"
            android:text="@string/focus_notify_anyway"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/readOnlyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/chat_read_only"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp">

        <ImageButton
            android:id="@+id/attach"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_attach"
            android:src="@drawable/ic_attach" />

        <ImageButton
            android:id="@+id/stickers"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_stickers"
            android:src="@drawable/ic_sticker" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputBox"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:boxCornerRadiusBottomEnd="24dp"
            app:boxCornerRadiusBottomStart="24dp"
            app:boxCornerRadiusTopEnd="24dp"
            app:boxCornerRadiusTopStart="24dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/chat_compose_hint"
                android:inputType="textMultiLine|textCapSentences|textShortMessage|textAutoCorrect"
                android:maxLines="6" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dictation through the system's speech recogniser; hidden when there is none. -->
        <ImageButton
            android:id="@+id/voiceInput"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_voice_input"
            android:src="@drawable/ic_mic"
            android:visibility="gone" />

        <!-- Records a voice message (Google Messages only). -->
        <ImageButton
            android:id="@+id/voiceMessage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_voice_record"
            android:src="@drawable/ic_voice_message"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_send"
            android:src="@drawable/ic_send"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>
</LinearLayout>
