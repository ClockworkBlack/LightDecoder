<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/stickersTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:paddingVertical="12dp"
            android:text="@string/sticker_sheet_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <!-- Tapped stickers are marked and sent together. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/stickersSeveral"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sticker_send_several"
            android:visibility="gone" />

        <!-- Switches the panel between sending a tapped sticker and editing it. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/stickersEditMode"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sticker_edit_mode"
            android:visibility="gone"
            app:icon="@drawable/ic_edit" />
    </LinearLayout>

    <TextView
        android:id="@+id/stickersEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/sticker_sheet_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stickersGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="true" />

    <TextView
        android:id="@+id/stickersHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="@string/sticker_sheet_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stickersSendChosen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:enabled="false"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stickersNew"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sticker_new" />

    <!-- Made stickers are copied to the gallery; after reinstalling, they come back from there. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/stickersRestore"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sticker_restore" />
</LinearLayout>
