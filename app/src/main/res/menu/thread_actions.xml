<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Messages tab with Blue Bubbles on: the iMessage light (ui.chat.IMessageLight). -->
    <item
        android:id="@+id/action_imessage_light"
        android:title="@string/imessage_light"
        android:visible="false"
        app:actionLayout="@layout/action_imessage_light"
        app:showAsAction="always" />
    <!-- One-to-one conversations with a phone number: opens the phone's dialer with it. -->
    <item
        android:id="@+id/action_call"
        android:icon="@drawable/ic_call"
        android:title="@string/chat_call"
        android:visible="false"
        app:showAsAction="always" />
    <!--
        FaceTime, for a chat with one person the iMessage library reaches (and whom Apple does not say
        cannot be called), or a group chat (one call to its members who can be called), with
        "FaceTime" on. In iPhone-style chats a camera in the bar, which asks Video or Audio; elsewhere
        the two in the menu.
    -->
    <item
        android:id="@+id/action_facetime"
        android:icon="@drawable/ic_ft_video"
        android:title="@string/facetime_button"
        android:visible="false"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_facetime_video"
        android:title="@string/facetime_video"
        android:visible="false"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_facetime_audio"
        android:title="@string/facetime_audio"
        android:visible="false"
        app:showAsAction="never" />
    <!-- Only while something is being read aloud. -->
    <item
        android:id="@+id/action_stop_reading"
        android:icon="@drawable/ic_stop_reading"
        android:title="@string/chat_stop_reading"
        android:visible="false"
        app:showAsAction="ifRoom" />
    <!-- A Messages conversation with Blue Bubbles on: its person's iMessage chat (here, or new: through the iMessage library, or in OpenBubbles). -->
    <item
        android:id="@+id/action_send_imessage"
        android:title="@string/imessage_send_imessage"
        android:visible="false"
        app:showAsAction="never" />
    <!-- A Messages conversation with the person's iMessages in it: is it blue on their iPhone? -->
    <item
        android:id="@+id/action_check_imessage"
        android:title="@string/imessage_check"
        android:visible="false"
        app:showAsAction="never" />
    <!-- Blue Bubbles: put an iMessage chat inside this conversation by hand, or take it out. -->
    <item
        android:id="@+id/action_link_imessage"
        android:title="@string/imessage_link"
        android:visible="false"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_unlink_imessage"
        android:title="@string/imessage_unlink"
        android:visible="false"
        app:showAsAction="never" />
    <!-- An iMessage chat the iMessage library can reach: its background (iOS 26), as on an iPhone. -->
    <item
        android:id="@+id/action_chat_background"
        android:title="@string/imessage_background"
        android:visible="false"
        app:showAsAction="never" />
    <!-- An iMessage chat: the same chat in OpenBubbles (not through the iMessage library, which opens no other app). -->
    <item
        android:id="@+id/action_open_openbubbles"
        android:title="@string/imessage_open_in_openbubbles"
        android:visible="false"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_archive"
        android:title="@string/chat_action_archive"
        app:showAsAction="never" />
    <!-- Only in Spam. -->
    <item
        android:id="@+id/action_not_spam"
        android:title="@string/chat_action_not_spam"
        android:visible="false"
        app:showAsAction="never" />
    <!-- Only in the local Deleted folder (the phone already deleted it). -->
    <item
        android:id="@+id/action_restore"
        android:title="@string/chat_action_restore"
        android:visible="false"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_delete_forever"
        android:title="@string/chat_action_delete_forever"
        android:visible="false"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_mute"
        android:title="@string/chat_action_mute"
        app:showAsAction="never" />
    <!-- Unread again, and back to the list (as on an iPhone, through the iMessage library the user's other devices are told). -->
    <item
        android:id="@+id/action_mark_unread"
        android:title="@string/chat_action_mark_unread"
        android:visible="false"
        app:showAsAction="never" />
    <!-- A chat with someone not in the user's contacts, whom the user never wrote to: reported to Apple, then deleted here. -->
    <item
        android:id="@+id/action_report_junk"
        android:title="@string/imessage_junk_report"
        android:visible="false"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_delete_conversation"
        android:title="@string/chat_action_delete_conversation"
        app:showAsAction="never" />
    <!-- Hidden for Gmail, and while read notifications are off altogether. -->
    <item
        android:id="@+id/action_notify_read"
        android:checkable="true"
        android:title="@string/read_notify_person"
        android:visible="false"
        app:showAsAction="never" />
    <!-- Hidden when there is no text-to-speech engine. -->
    <item
        android:id="@+id/action_read_new_aloud"
        android:checkable="true"
        android:title="@string/chat_read_new_aloud"
        android:visible="false"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_link_status"
        android:title="@string/chat_link_status"
        app:showAsAction="never" />
</menu>
