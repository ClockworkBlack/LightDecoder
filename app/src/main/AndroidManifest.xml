<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightDecoder">

        <activity
            android:name=".ui.ViewerActivity"
            android:exported="true"
            android:label="@string/app_name">

            <!-- Launcher entry. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Opening a HEIC by tapping it (file manager, "open with"). -->
            <intent-filter android:label="@string/open_with">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
                <data android:mimeType="image/heic-sequence" />
                <data android:mimeType="image/heif-sequence" />
            </intent-filter>

            <!-- A sticker shared into the app from Messages, Photos, etc. -->
            <intent-filter android:label="@string/open_with">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
                <data android:mimeType="image/heic-sequence" />
                <data android:mimeType="image/heif-sequence" />
            </intent-filter>

            <!-- Some senders label HEIC as a generic image; match by .heic name too. -->
            <intent-filter
                android:autoVerify="false"
                android:label="@string/open_with">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.heic" />
                <data android:pathPattern=".*\\.HEIC" />
                <data android:pathPattern=".*\\.heif" />
                <data android:pathPattern=".*\\.heics" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
