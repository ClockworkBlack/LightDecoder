*.iml
.gradle/
.idea/
.kotlin/
build/
captures/
.externalNativeBuild/
.cxx/
local.properties

# Built by :app:buildGoBridge (gomobile bind of gmbridge/).
/app/libs/

# Pinned HEVC/HEIF sources are vendored as submodules, not copies.

# Test media is generated by tools/make-test-media; the sample files are small
# and committed so the tests run without an HEVC encoder.

# Release signing keys never go into the repository; app/build.gradle.kts reads
# the keystore's location and passwords from the environment or Gradle properties.
*.jks
*.keystore
*.p12
*.pfx
/LightDecoder-*.apk

# Built apps and native libraries never go in either: OpenBubbles' libraries are
# imported or built in from outside (docs/imessage-openbubbles.md, bundleImessageLibs
# in app/build.gradle.kts) and must not be published; APKs built with them neither.
*.so
app/src/main/jniLibs/
*.apk
*.apks
*.xapk
*.tipa

# Where tools/openbubbles-inspect/README.md has OpenBubbles' APK pulled off a phone.
/tools/openbubbles-inspect/openbubbles/
