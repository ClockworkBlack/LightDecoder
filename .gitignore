# Built by :app:buildGoBridge (gomobile bind of gmbridge/).
/app/libs/

# Pinned HEVC/HEIF sources are vendored as submodules, not copies.

# Test media is generated by tools/make-test-media; the sample files are small
# and committed so the tests run without an HEVC encoder.

# Release signing keys never go into the repository; app/build.gradle.kts reads
# the keystore's location and passwords from the environment or Gradle properties.
*.jks
*.keystore
/LightDecoder-*.apk
