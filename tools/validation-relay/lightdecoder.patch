+
+/// The log file, and catching crashes into it.
+final class RelayLogFile {
+    static let shared = RelayLogFile()
+
+    let url: URL
+    private let markerURL: URL
+    private let queue = DispatchQueue(label: "relay-log")
+    private var started = false
+    private var notes: [String] = []
+    private static let maxBytes = 512 * 1024
+
+    private init() {
+        let docs = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first!
+        url = docs.appendingPathComponent("relay-log.txt")
+        markerURL = docs.appendingPathComponent("relay-running")
+    }
+
+    func start() {
+        if started { return }
+        started = true
+        trim()
+        // Still there from the last run: it never ended cleanly.
+        if FileManager.default.fileExists(atPath: markerURL.path) {
+            notes.append("The last run ended unexpectedly (a crash, or iOS closed the app). Its log is in the shared file.")
+        }
+        if let last = try? String(contentsOf: url, encoding: .utf8) {
+            let crashes = last.split(separator: "\n").filter { $0.contains("CRASH") }.suffix(3)
+            for line in crashes { notes.append("Earlier: " + line) }
+        }
+        FileManager.default.createFile(atPath: markerURL.path, contents: Data())
+        installCrashHandlers(path: url.path)
+        NotificationCenter.default.addObserver(forName: UIApplication.willTerminateNotification, object: nil, queue: nil) { [weak self] _ in
+            self?.append("App closing normally", isError: false)
+            self?.cleanExit()
+        }
+    }
+
+    func previousRunNotes() -> [String] { notes }
+
+    /// The user closed the app, or iOS is ending it the normal way.
+    func cleanExit() {
+        try? FileManager.default.removeItem(at: markerURL)
+    }
+
+    func append(_ message: String, isError: Bool) {
+        let stamp = ISO8601DateFormatter().string(from: Date())
+        let line = "\(stamp) \(isError ? "E" : "I") \(message)\n"
+        queue.async { [url] in
+            guard let data = line.data(using: .utf8) else { return }
+            if let handle = try? FileHandle(forWritingTo: url) {
+                handle.seekToEndOfFile()
+                handle.write(data)
+                try? handle.close()
+            } else {
+                try? data.write(to: url)
+            }
+        }
+    }
+
+    /// Keeps the file to its newest half megabyte.
+    private func trim() {
+        guard let data = try? Data(contentsOf: url), data.count > RelayLogFile.maxBytes else { return }
+        let tail = data.suffix(RelayLogFile.maxBytes / 2)
+        try? Data(tail).write(to: url)
+    }
+
+    func clear() {
+        queue.async { [url] in try? Data().write(to: url) }
+    }
+
+    static func deviceSummary() -> String {
+        var info = utsname()
+        uname(&info)
+        let machine = withUnsafePointer(to: &info.machine) {
+            $0.withMemoryRebound(to: CChar.self, capacity: 256) { String(cString: $0) }
+        }
+        let version = Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String ?? "?"
+        return "\(machine), iOS \(UIDevice.current.systemVersion), Relay \(version) (LightDecoder patch)"
+    }
+}
+
+// --- crash catching -------------------------------------------------------------------------
+// A crash (a Swift trap, a fatal error, a bad memory access) is written to the log file
+// from the signal handler with write(2) only, the one thing safe to do there.
+
+private var crashFD: Int32 = -1
+
+private func writeCrash(_ text: StaticString) {
+    guard crashFD >= 0 else { return }
+    _ = text.withUTF8Buffer { write(crashFD, $0.baseAddress, $0.count) }
+}
+
+private func installCrashHandlers(path: String) {
+    crashFD = open(path, O_WRONLY | O_APPEND | O_CREAT, 0o644)
+    NSSetUncaughtExceptionHandler { exception in
+        RelayLogFile.shared.append("CRASH: uncaught exception \(exception.name.rawValue): \(exception.reason ?? "")", isError: true)
+        Thread.sleep(forTimeInterval: 0.2)
+    }
+    let handler: @convention(c) (Int32) -> Void = { sig in
+        switch sig {
+        case SIGTRAP: writeCrash("\nCRASH: SIGTRAP (a Swift error: a failed try!, a nil unwrap or an assert)\n")
+        case SIGABRT: writeCrash("\nCRASH: SIGABRT (the app aborted)\n")
+        case SIGSEGV: writeCrash("\nCRASH: SIGSEGV (bad memory access)\n")
+        case SIGBUS: writeCrash("\nCRASH: SIGBUS (bad memory access)\n")
+        case SIGILL: writeCrash("\nCRASH: SIGILL (illegal instruction)\n")
+        default: writeCrash("\nCRASH: signal\n")
+        }
+        signal(sig, SIG_DFL)
+        raise(sig)
     }
+    for sig in [SIGTRAP, SIGABRT, SIGSEGV, SIGBUS, SIGILL] { signal(sig, handler) }
 }
 
