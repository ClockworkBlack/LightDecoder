+    func record(_ event: String, _ message: String, level: String = "I", fields: [String: Any] = [:]) {
+        var object: [String: Any] = fields.mapValues { value -> Any in
+            if value is String || value is Int || value is Double || value is Bool { return value }
+            return String(describing: value)
