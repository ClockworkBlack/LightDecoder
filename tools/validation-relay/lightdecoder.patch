+/// "ev": event name, "msg": text, ...fields}. Events: app.start, app.active,
+/// app.background, app.foreground, app.terminate, app.unclean_exit, net.path,
+/// ws.connecting, ws.connected, ws.error, ws.disconnected, ws.reconnect,
