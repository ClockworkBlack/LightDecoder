+                if line.contains("CRASH") { counts["crash.signal", default: 0] += 1 }
+                continue
+            }
+            counts[event, default: 0] += 1
+            if event == "val.failed" { failures[(object["reason"] as? String) ?? "?", default: 0] += 1 }
+            if event == "ws.error" { wsErrors[(object["error"] as? String) ?? "?", default: 0] += 1 }
+            if event == "val.sent" || event == "val.failed" { lastValidation = "\(event) at \(object["t"] ?? "?")" }
+        }
+        func listed(_ map: [String: Int]) -> String {
+            map.isEmpty ? "none" : map.sorted { $0.value > $1.value }.map { "\($0.value)x \($0.key)" }.joined(separator: "; ")
+        }
+        var report = """
+        # ValidationRelay report (LightDecoder patch)
+        # Generated: \(ISO8601DateFormatter().string(from: Date()))
+        # Device: \(RelayLogFile.deviceSummary())
+        # Relay server: \(UserDefaults.standard.string(forKey: "savedRegistrationURL").flatMap { URL(string: $0)?.host } ?? "?")
+        # Events in log: \(lines.count)
+        #
+        # Summary
+        #   websocket connected: \(counts["ws.connected"] ?? 0), errors: \(counts["ws.error"] ?? 0), disconnects: \(counts["ws.disconnected"] ?? 0), reconnects: \(counts["ws.reconnect"] ?? 0)
+        #   websocket errors by kind: \(listed(wsErrors))
+        #   validation requested: \(counts["val.requested"] ?? 0), sent: \(counts["val.sent"] ?? 0), failed: \(counts["val.failed"] ?? 0)
+        #   validation failures by reason: \(listed(failures))
+        #   last validation: \(lastValidation)
+        #   version info asked: \(counts["relay.version_info"] ?? 0)
+        #   app to background: \(counts["app.background"] ?? 0), unclean exits: \(counts["app.unclean_exit"] ?? 0), crashes: \((counts["crash.signal"] ?? 0) + (counts["crash.exception"] ?? 0))
+        #   network changes: \(counts["net.path"] ?? 0)
+        #
+        # Format: one JSON object per line (t = time, ms = ms since that run's start, lvl = I/W/E, ev = event).
+        # Lines starting CRASH were written from a crash handler.
+
+        """
+        report += raw
+        try? report.write(to: reportURL, atomically: true, encoding: .utf8)
+        return reportURL
+    }
+
+    static func deviceFields() -> [String: Any] {
+        var info = utsname()
+        uname(&info)
+        let machine = withUnsafePointer(to: &info.machine) {
+            $0.withMemoryRebound(to: CChar.self, capacity: 256) { String(cString: $0) }
+        }
+        return [
+            "model": machine,
+            "ios": UIDevice.current.systemVersion,
+            // Not the bridging header's buildNumber(): a C function defined in a header gets a copy
+            // in every Swift file that calls it, and two copies do not link.
+            "build": osBuild(),
+            "app_version": Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String ?? "?",
+            "low_power": ProcessInfo.processInfo.isLowPowerModeEnabled,
+            "battery_state": UIDevice.current.batteryState.rawValue,
+        ]
+    }
+
+    private static func osBuild() -> String {
+        var size = 0
+        sysctlbyname("kern.osversion", nil, &size, nil, 0)
+        guard size > 0 else { return "?" }
+        var buffer = [CChar](repeating: 0, count: size)
+        sysctlbyname("kern.osversion", &buffer, &size, nil, 0)
+        return String(cString: buffer)
+    }
+
+    static func deviceSummary() -> String {
+        let f = deviceFields()
+        return "\(f["model"] ?? "?"), iOS \(f["ios"] ?? "?") (\(f["build"] ?? "?")), Relay \(f["app_version"] ?? "?") (LightDecoder patch)"
+    }
+}
