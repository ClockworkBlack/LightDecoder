+struct ValidationError: Error, CustomStringConvertible {
+    let description: String
+}
+
+private let validationSession: URLSession = {
+    let config = URLSessionConfiguration.ephemeral
+    config.timeoutIntervalForRequest = 20
+    config.timeoutIntervalForResource = 30
+    return URLSession(configuration: config)
+}()
+
+/// One HTTP request, waited for on the calling (background) thread.
+private func fetch(_ request: URLRequest) throws -> Data {
+    let done = DispatchSemaphore(value: 0)
+    var result: Result<Data, Error> = .failure(ValidationError(description: "no answer"))
+    validationSession.dataTask(with: request) { data, response, error in
+        if let error = error {
+            result = .failure(error)
+        } else if let http = response as? HTTPURLResponse, !(200..<300).contains(http.statusCode) {
+            result = .failure(ValidationError(description: "HTTP \(http.statusCode) from \(request.url?.host ?? "?")"))
+        } else {
+            result = .success(data ?? Data())
+        }
+        done.signal()
+    }.resume()
+    if done.wait(timeout: .now() + 35) == .timedOut {
+        throw ValidationError(description: "timed out reaching \(request.url?.host ?? "?")")
+    }
+    return try result.get()
+}
 
