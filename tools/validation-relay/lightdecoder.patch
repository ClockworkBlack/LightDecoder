+// --- crash catching -------------------------------------------------------------------------
+// A crash is written to the log file from the signal handler with write(2) only, the one thing
+// safe to do there. These lines are not JSON; the report counts them.
+
+private var crashFD: Int32 = -1
+
+private func writeCrash(_ text: StaticString) {
+    guard crashFD >= 0 else { return }
+    _ = text.withUTF8Buffer { write(crashFD, $0.baseAddress, $0.count) }
+}
+
+private func installCrashHandlers(path: String) {
+    crashFD = open(path, O_WRONLY | O_APPEND | O_CREAT, 0o644)
+    NSSetUncaughtExceptionHandler { exception in
+        RelayLogFile.shared.record("crash.exception", "Uncaught exception \(exception.name.rawValue): \(exception.reason ?? "")", level: "E",
+                                   fields: ["stack": exception.callStackSymbols.prefix(15).joined(separator: " | ")])
+        Thread.sleep(forTimeInterval: 0.3)
+    }
+    let handler: @convention(c) (Int32) -> Void = { sig in
+        switch sig {
+        case SIGTRAP: writeCrash("\nCRASH SIGTRAP: a Swift error (a failed try!, a nil unwrap or an assert)\n")
+        case SIGABRT: writeCrash("\nCRASH SIGABRT: the app aborted\n")
+        case SIGSEGV: writeCrash("\nCRASH SIGSEGV: bad memory access\n")
+        case SIGBUS: writeCrash("\nCRASH SIGBUS: bad memory access\n")
+        case SIGILL: writeCrash("\nCRASH SIGILL: illegal instruction\n")
+        default: writeCrash("\nCRASH: signal\n")
+        }
+        signal(sig, SIG_DFL)
+        raise(sig)
     }
+    for sig in [SIGTRAP, SIGABRT, SIGSEGV, SIGBUS, SIGILL] { signal(sig, handler) }
 }
 
