+        queue.async { [url] in
+            if let handle = try? FileHandle(forWritingTo: url) {
+                handle.seekToEndOfFile()
+                handle.write(line)
+                try? handle.close()
+            } else {
+                try? line.write(to: url)
+            }
+        }
+    }
+
+    private func trim() {
+        guard let data = try? Data(contentsOf: url), data.count > RelayLogFile.maxBytes else { return }
+        var tail = Data(data.suffix(RelayLogFile.maxBytes / 2))
