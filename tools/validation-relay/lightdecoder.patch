+/// The log file, the report shared from it, and catching crashes into it.
+final class RelayLogFile {
+    static let shared = RelayLogFile()
+
+    let url: URL
+    let reportURL: URL
+    private let markerURL: URL
+    private let queue = DispatchQueue(label: "relay-log")
+    private var started = false
+    private var notes: [String] = []
+    private let startTime = Date()
+    private var pathMonitor: NWPathMonitor?
+    private static let maxBytes = 1024 * 1024
+
+    private init() {
+        let docs = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first!
+        url = docs.appendingPathComponent("relay-log.jsonl")
+        reportURL = docs.appendingPathComponent("relay-report.txt")
+        markerURL = docs.appendingPathComponent("relay-running")
+    }
+
+    func start() {
+        if started { return }
+        started = true
+        trim()
+        if FileManager.default.fileExists(atPath: markerURL.path) {
+            notes.append("The last run ended unexpectedly (a crash, or iOS closed the app).")
+            record("app.unclean_exit", "The last run did not end cleanly", level: "E")
+        }
+        FileManager.default.createFile(atPath: markerURL.path, contents: Data())
+        installCrashHandlers(path: url.path)
+        let center = NotificationCenter.default
+        center.addObserver(forName: UIApplication.willTerminateNotification, object: nil, queue: nil) { [weak self] _ in
+            self?.record("app.terminate", "App closing normally")
+            self?.cleanExit()
+        }
+        // The relay has to stay in front: going to the background is the usual reason it drops.
+        center.addObserver(forName: UIApplication.didEnterBackgroundNotification, object: nil, queue: nil) { [weak self] _ in
+            self?.record("app.background", "App went to the background: the relay stops answering while it is there", level: "W")
+        }
+        center.addObserver(forName: UIApplication.willEnterForegroundNotification, object: nil, queue: nil) { [weak self] _ in
+            self?.record("app.foreground", "App came back to the front")
+        }
+        center.addObserver(forName: UIApplication.didBecomeActiveNotification, object: nil, queue: nil) { [weak self] _ in
+            self?.record("app.active", "App active", fields: ["idle_timer_disabled": UIApplication.shared.isIdleTimerDisabled])
+        }
+        let monitor = NWPathMonitor()
+        monitor.pathUpdateHandler = { [weak self] path in
+            var kinds: [String] = []
+            if path.usesInterfaceType(.wifi) { kinds.append("wifi") }
+            if path.usesInterfaceType(.cellular) { kinds.append("cellular") }
+            if path.usesInterfaceType(.wiredEthernet) { kinds.append("wired") }
+            let status: String
+            switch path.status {
+            case .satisfied: status = "online"
+            case .unsatisfied: status = "offline"
+            case .requiresConnection: status = "requires_connection"
+            @unknown default: status = "unknown"
+            }
+            self?.record("net.path", "Network \(status) \(kinds.joined(separator: "+"))", level: path.status == .satisfied ? "I" : "W",
+                         fields: ["status": status, "interfaces": kinds.joined(separator: "+"), "expensive": path.isExpensive, "constrained": path.isConstrained])
+        }
+        monitor.start(queue: queue)
+        pathMonitor = monitor
+    }
+
+    func previousRunNotes() -> [String] { notes }
+
+    func cleanExit() {
