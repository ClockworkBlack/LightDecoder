+func getCertificate() throws -> Data {
+    var lastError: Error = ValidationError(description: "no certificate")
+    for address in ["http://static.ess.apple.com/identity/validation/cert-1.0.plist",
+                    "https://static.ess.apple.com/identity/validation/cert-1.0.plist"] {
+        do {
+            let plist = try plistDict(try fetch(URLRequest(url: URL(string: address)!)), "certificate")
+            guard let cert = plist["cert"] as? Data else { throw ValidationError(description: "certificate plist has no cert") }
+            return cert
+        } catch {
+            lastError = error
+        }
+    }
+    throw lastError
+}
